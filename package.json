    "browser:smoke": "node scripts/browser-smoke.mjs",
    "browser:fallback": "node scripts/browser-fallback-smoke.mjs",
    "assets:fetch": "python3 scripts/fetch-assets.py"
  },
  "engines": {
    "node": ">=20"
  }
}