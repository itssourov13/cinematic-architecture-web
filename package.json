{
  "name": "glass-pavilion-reconstruction",
  "version": "1.0.0",
  "private": true,
  "description": "Static, fidelity-first reconstruction of the recovered Glass Pavilion experience.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
